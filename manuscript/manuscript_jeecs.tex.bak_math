\appendix
\section{State-Space Matrices and Analytic Jacobians\label{app:jacobians}}
For the 3-state NMC ($\mathbf{x}_k \in \mathbb{R}^3$) and 4-state LFP ($\mathbf{x}_k^{\text{LFP}} \in \mathbb{R}^4$) models, the state transition matrices and observation Jacobians are:
\begin{align}
\mathbf{A}_k^{\text{NMC}} &= \operatorname{diag}(1, a_1, a_2), \quad \mathbf{A}_k^{\text{LFP}} = \operatorname{diag}(1, a_1, a_2, a_h), \label{eqn:app_A}\\
\mathbf{H}_k^{\text{NMC}} &= \begin{bmatrix} V_{\text{ocv}}'(\widehat{\text{SOC}}_k^-) & -1 & -1 \end{bmatrix}, \label{eqn:app_H_nmc}\\
\mathbf{H}_k^{\text{LFP}} &= \begin{bmatrix} V_{\text{ocv}}'(\widehat{\text{SOC}}_k^-) & -1 & -1 & -1 \end{bmatrix}, \label{eqn:app_H_lfp}
\end{align}
where $a_i = e^{-\Delta t/\tau_i}$, $a_h = e^{-\beta|\Delta z_k|}$, deterministic inputs are $\mathbf{B}_k^{\text{NMC}} = [B_{1,k}, B_{2,k}, B_{3,k}]^T$ via Eq.~\eqref{eqn:Bk_mat}, $\mathbf{B}_k^{\text{LFP}} = [\mathbf{B}_k^{\text{NMC}}; 0]$, and $\mathbf{g}_k = [0, 0, 0, (1 - a_h) M(z_k) \operatorname{sgn}(I_k)]^T$. In DEKF, the Fréchet parameter sensitivity matrix $\mathbf{C}_{\theta,k} = \left. \frac{d V_k}{d \boldsymbol{\theta}} \right|_{\hat{\boldsymbol{\theta}}_k^-} \in \mathbb{R}^{1 \times 2}$ is:
\begin{equation}\label{eqn:app_C_theta}
\mathbf{C}_{\theta,k} = \begin{bmatrix} -I_k & -\frac{\eta \Delta t I_{k-1}}{3600} V_{\text{ocv}}'(\widehat{\text{SOC}}_k^+) \end{bmatrix}.
\end{equation}

\section{Lyapunov Stability, Finite-Time Reaching, and Error Boundedness of SMO\label{app:lyapunov}}
Define sliding manifold $S(t) = V_{\text{meas}}(t) - \hat{V}_t(t)$. Error dynamics follow $\dot{S} = \Delta \dot{f}(t) - \gamma(\hat{z}) \operatorname{sat}(S/\mu)$ with disturbance $|\Delta \dot{f}(t)| \le \Phi < \infty$ and injection gain $\gamma(\hat{z}) \equiv \mathbf{H}\mathbf{L} = l_1 V_{\text{ocv}}'(\hat{z}) - l_2 - l_3$ for NMC ($\gamma = l_1 V_{\text{ocv}}' - l_2 - l_3 - l_h$ for LFP). Since $V_{\text{ocv}}' \ge \alpha > 0$ ($\alpha = 0.481\text{ V}$ for NMC, $\approx 0.08\text{ V}$ for LFP), choosing $l_1 > (l_2 + l_3 + \Phi + \eta_s)/\alpha$ ensures $\gamma(\hat{z}) \ge \gamma_{\min} \ge \Phi + \eta_s > 0$ with margin $\eta_s > 0$.

Consider Lyapunov candidate $V(S) = \frac{1}{2} S^2$.
(1)~\emph{Finite-Time Reaching ($|S| > \mu$)}: Since $\operatorname{sat}(S/\mu) = \operatorname{sgn}(S)$, derivative $\dot{V} = S \Delta \dot{f} - \gamma |S| \le -(\gamma_{\min} - \Phi)|S| \le -\eta_s |S| = -\eta_s \sqrt{2V}$. Integrating $\frac{dV}{\sqrt{V}} \le -\eta_s \sqrt{2} dt$ proves trajectories reach boundary $\mathcal{B}_\mu \equiv \{S \mid |S| \le \mu\}$ in finite time $t_{\text{reach}} \le (|S(0)| - \mu)/\eta_s$.
(2)~\emph{Boundary Invariance ($|S| \le \mu$)}: Inside $\mathcal{B}_\mu$, $\dot{S} = -(\gamma/\mu)S + \Delta \dot{f}$, giving $\dot{V} \le -(\gamma_{\min}/\mu)S^2 + \Phi |S| < 0$ for $|S| > \mu\Phi/\gamma_{\min}$. Since $\gamma_{\min} > \Phi$, the compact set $\Omega_{\text{ult}} \equiv \{S \mid |S| \le \mu\Phi/\gamma_{\min} < \mu\} \subset \mathcal{B}_\mu$ is positively invariant, eliminating chattering.
(3)~\emph{Uniform Ultimate Boundedness (UUB) of $\mathbf{e}_x$}: Within $\mathcal{B}_\mu$, equivalent control $|u_{\text{eq}}| \le \Phi/\gamma_{\min}$. Polarization errors $\dot{e}_{U_i} = -\frac{1}{\tau_i} e_{U_i} - l_{i+1} u_{\text{eq}} + d_{U_i}$ are exponentially ISS with bound $|e_{U_i}| \le \tau_i(|l_{i+1}|\frac{\Phi}{\gamma_{\min}} + D_{U_i}) \equiv \bar{e}_{U_i}$. By Mean Value Theorem, $V_{\text{ocv}}(z) - V_{\text{ocv}}(\hat{z}) = V_{\text{ocv}}'(\xi) e_z$ with $\xi \in (\hat{z}, z)$. Thus:
\begin{equation}\label{eqn:e_z_bound}
|e_z(t)| \le \frac{|S(t)| + \sum_{i=1}^2 |e_{U_i}(t)| + |v(t)|}{V_{\text{ocv}}'(\xi)} \le \frac{\mu + \bar{e}_{U_1} + \bar{e}_{U_2} + V_{\text{noise}}}{\alpha}.
\end{equation}
Since $V_{\text{ocv}}'(\xi) \ge \alpha > 0$ on $z \in [0, 1]$, the denominator is strictly positive and bounded away from zero. Consequently, full error vector $\|\mathbf{e}_x(t)\|$ is Uniformly Ultimately Bounded (UUB), completing the proof.

